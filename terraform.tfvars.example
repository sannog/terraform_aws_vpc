aws_region   = "us-east-1"
project_name = "tf-vpc-demo"

# 203.0.113.0/24 is the TEST-NET-3 documentation range - replace this with your
# own address (curl ifconfig.me) before applying.
my_ip = "203.0.113.0/32"

instance_type = "t3.micro"

# Existing key pair in the target region. Remove this line to skip SSH access.
key_name = "example-keypair"
